#!/bin/sh
# Keep the vendored KB copy (connect-four/server/kb/) in sync with the authored
# source (docs/knowledge-base/) on every commit.
#
# Railway ships only the connect-four/ subtree, so the KB must be committed
# inside it — see connect-four/scripts/sync-kb.mjs and connect-four/server/kbDir.js.
# This hook re-mirrors the KB and stages any resulting changes so a docs/ edit
# and its vendored copy always land in the same commit. If nothing changed, it
# is a no-op.
#
# Enabled via `git config core.hooksPath .githooks` (auto-set by the `prepare`
# script in connect-four/package.json on `npm install`).

repo_root=$(git rev-parse --show-toplevel)

# Lint runs first, before sync-kb, so a commit that's going to be rejected on
# lint errors never triggers sync-kb.mjs mutating/staging connect-four/server/kb/
# (see specs/055-dev-infra-test-quality/research.md R5). Measured full-tree lint
# wall time: ~6.7s (`time npm run lint`, connect-four/, 2026-08-02).
#
# `--quiet` limits output to errors: the gate is error-level only (warnings are the
# deliberately-demoted react-hooks/react-refresh set tracked in OI-119), and without
# it every commit dumps ~47 verbose warnings, which trains people to ignore the hook.
# Run `npm run lint` directly to see the warnings.
(cd "$repo_root/connect-four" && npx eslint . --quiet) || {
  echo "pre-commit: lint failed" >&2
  exit 1
}

node "$repo_root/connect-four/scripts/sync-kb.mjs" || {
  echo "pre-commit: sync-kb failed" >&2
  exit 1
}

git add -- "$repo_root/connect-four/server/kb"
