{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "buildAptPackages": ["g++", "gcc", "make"],
  "steps": {
    "build": {
      "commands": [
        "cd solver-src && make -B SERVER_DIR=../server && test -f ../server/c4solver",
        "npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "node server/migrate.js && node server/index.js"
  }
}
