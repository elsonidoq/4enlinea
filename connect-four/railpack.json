{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "buildAptPackages": ["g++", "gcc", "make"],
  "steps": {
    "build": {
      "commands": [
        "cd ../solver-src && make",
        "npm run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "node server/migrate.js && node server/index.js"
  }
}
