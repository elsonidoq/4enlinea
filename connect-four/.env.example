# ─────────────────────────────────────────────────────────────────────────────
# DecodeC4 environment variables
# Copy this file to .env (server) and .env.local (Vite frontend) and fill in
# your real credentials. Never commit files containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (server) ─────────────────────────────────────────────────────────
# Project URL — found in Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service role key (full DB access — keep secret, server-side only)
# Found in Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase (frontend / Vite) ────────────────────────────────────────────────
# These are exposed to the browser; use only the anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Anthropic ─────────────────────────────────────────────────────────────────
# API key for Claude — found at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ───────────────────────────────────────────────────────────────────
# Secret key — found in Stripe dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from Stripe dashboard → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for the two subscription plans (Stripe dashboard → Products)
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...

# ── Solver ────────────────────────────────────────────────────────────────────
# Absolute path to the compiled c4solver binary (only needed if overriding
# the default which looks for ./c4solver relative to server/index.js)
# C4_SOLVER_PATH=/usr/local/bin/c4solver

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the frontend — used for Stripe redirect URLs
FRONTEND_URL=http://localhost:5173

# Server port (default: 3001)
# PORT=3001

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# DSN for server-side error tracking — leave blank to disable
# SENTRY_DSN=https://...@sentry.io/...
