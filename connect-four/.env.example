# ─────────────────────────────────────────────────────────────────────────────
# DecodeC4 environment variables
# Copy this file to .env (server) and fill in
# your real credentials. Never commit files containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (server) ─────────────────────────────────────────────────────────
# Project URL — found in Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service role key (full DB access — keep secret, server-side only)
# Found in Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ─────────────────────────────────────────────────────────────────
# API key for Claude — found at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Paddle ────────────────────────────────────────────────────────────────────
# Sandbox API key — Paddle dashboard → Developer tools → Authentication.
# Sandbox keys contain `_sdbx`; never use a live key in dev.
PADDLE_API_KEY=pdl_sdbx_...

# Price IDs for the two subscription plans (Paddle dashboard → Catalog → Products)
PADDLE_MONTHLY_PRICE_ID=pri_...
PADDLE_ANNUAL_PRICE_ID=pri_...

# Webhook notification signing secret — from Paddle dashboard → Developer tools →
# Notifications → your notification destination.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=ntfset_...

# Frontend (browser) Paddle.js client-side token — sandbox tokens are prefixed
# `test_`. Must be exposed to the client via the VITE_ prefix.
VITE_PADDLE_CLIENT_TOKEN=test_...

# ── Solver ────────────────────────────────────────────────────────────────────
# Absolute path to the compiled c4solver binary (only needed if overriding
# the default which looks for ./c4solver relative to server/index.js)
# C4_SOLVER_PATH=/usr/local/bin/c4solver

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the frontend — used for Paddle checkout return handling
FRONTEND_URL=http://localhost:5173

# Server port (default: 3001)
# PORT=3001

# ── Sentry (optional) ─────────────────────────────────────────────────────────
# DSN for server-side error tracking — leave blank to disable
# SENTRY_DSN=https://...@sentry.io/...

# Frontend (browser) Sentry DSN — separate project/DSN from the server SENTRY_DSN above.
# Must be exposed to the client via the VITE_ prefix.
# VITE_SENTRY_DSN=https://<public-key>@o<org>.ingest.sentry.io/<project>
